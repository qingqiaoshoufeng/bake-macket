# Local development values only. Copy to .env and replace with environment-specific values.
NODE_ENV=development

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bake_mall
MYSQL_USER=bake_app
MYSQL_PASSWORD=<set-a-local-password>

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bake-mall
S3_ACCESS_KEY=<set-a-local-access-key>
S3_SECRET_KEY=<set-a-local-secret-key>
