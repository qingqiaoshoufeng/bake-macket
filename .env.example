# Local development values only. Copy to .env for the Docker Compose defaults below.
NODE_ENV=development

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bake_mall
MYSQL_USER=bake_app
MYSQL_PASSWORD=bake_app_password

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=bake-mall
OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/bake-mall
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
PRODUCT_MEDIA_ALLOWED_ORIGINS=http://127.0.0.1:9000

# Membership development controls. Keep simulated payments disabled in production.
SIMULATED_PAYMENT_ENABLED=true
ORDER_QUOTE_TOKEN_SECRET=dev-only-order-quote-secret-must-be-at-least-32
ORDER_QUOTE_TTL_SECONDS=300
