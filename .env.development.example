# Runnable local defaults. Copy to .env.development, or let pnpm services:* create it.
NODE_ENV=development
HOST=127.0.0.1
PORT=43015
H5_PORT=43173
ADMIN_PORT=43174
MYSQL_PORT=43306
MINIO_API_PORT=43900
MINIO_CONSOLE_PORT=43901

MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=bake_mall
MYSQL_USER=bake_app
MYSQL_PASSWORD=bake_app_password
MYSQL_ROOT_PASSWORD=local_root_password

JWT_USER_SECRET=dev-only-user-jwt-secret-do-not-use-in-prod
JWT_ADMIN_SECRET=dev-only-admin-jwt-secret-do-not-use-in-prod
ADMIN_OPERATION_IDEMPOTENCY_SECRET=dev-only-admin-operation-idempotency-secret-do-not-use-in-prod
JWT_EXPIRES_IN_SECONDS=86400
SIMULATED_PAYMENT_ENABLED=true
ORDER_QUOTE_TOKEN_SECRET=dev-only-order-quote-secret-must-be-at-least-32
ORDER_QUOTE_TTL_SECONDS=300
# Optional locally: leave empty to keep development fake login enabled.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional locally: fake-only values target a loopback fake server and must never call the vendor.
XPYUN_USER=local-xpyun-user
XPYUN_USER_KEY=local-xpyun-user-key
XPYUN_BASE_URL=http://127.0.0.1:43999
XPYUN_TIMEOUT_MS=10000

ADMIN_EMAIL=admin-local@example.com
ADMIN_PASSWORD=admin-password

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:43900
OBJECT_STORAGE_CLIENT_ENDPOINT=https://12fg2re344234.vicp.fun
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=bake-mall
OBJECT_STORAGE_PUBLIC_BASE_URL=https://12fg2re344234.vicp.fun/bake-mall
PRODUCT_MEDIA_ALLOWED_ORIGINS=https://12fg2re344234.vicp.fun
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true

VITE_ADMIN_EMAIL=admin-local@example.com
VITE_ADMIN_PASSWORD=admin-password
VITE_H5_DEV_PHONE=13800000000
VITE_H5_DEV_CODE=123456
