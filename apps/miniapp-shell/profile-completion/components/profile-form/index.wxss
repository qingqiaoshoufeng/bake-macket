.profile-form {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.profile-form__avatar-button {
  width: 184rpx;
  height: 184rpx;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
}
.profile-form__avatar {
  width: 100%;
  height: 100%;
}
.profile-form__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf6ea;
  color: #547a4a;
  font-size: 26rpx;
}
.profile-form__field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  color: #3f4b3a;
  font-size: 28rpx;
}
.profile-form__field input {
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9e4d5;
  border-radius: 20rpx;
  background: #fff;
}
.profile-form__error {
  color: #bc5d58;
  font-size: 24rpx;
}
.profile-form__save {
  margin-top: 10rpx;
  background: #76a56b;
}
.profile-form__skip {
  background: transparent;
  color: #72816d;
}
