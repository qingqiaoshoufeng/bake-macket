.phone-auth-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #fffaf3;
  box-sizing: border-box;
}

.phone-auth-card {
  margin-top: 18vh;
  padding: 40rpx 32rpx 24rpx;
  border: 1rpx solid #eadfd2;
  border-radius: 28rpx;
  background: #ffffff;
}

.phone-auth-title,
.phone-auth-copy {
  display: block;
}

.phone-auth-title {
  margin-bottom: 16rpx;
  color: #3f3932;
  font-size: 36rpx;
  font-weight: 600;
}

.phone-auth-copy {
  margin-bottom: 32rpx;
  color: #6f675d;
  font-size: 28rpx;
  line-height: 1.6;
}

.phone-auth-button {
  background: #7da77d;
  border-radius: 16rpx;
}

.phone-auth-cancel {
  margin-top: 16rpx;
  color: #6f675d;
  background: transparent;
  border: 0;
}
