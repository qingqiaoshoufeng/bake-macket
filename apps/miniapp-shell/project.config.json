{
  "appid": "touristappid",
  "compileType": "miniprogram",
  "libVersion": "3.17.1",
  "miniprogramRoot": "./",
  "projectname": "bake-mall-miniapp-shell",
  "packOptions": {
    "ignore": [
      {
        "value": "node_modules",
        "type": "folder"
      },
      {
        "value": "scripts",
        "type": "folder"
      },
      {
        "value": "types",
        "type": "folder"
      },
      {
        "value": ".spec.ts",
        "type": "suffix"
      }
    ],
    "include": []
  },
  "setting": {
    "checkInvalidKey": true,
    "coverView": true,
    "es6": true,
    "postcss": true,
    "preloadBackgroundData": false,
    "urlCheck": true,
    "useCompilerPlugins": ["typescript"],
    "compileWorklet": false,
    "minified": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "enhance": false,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "condition": false,
    "swc": false,
    "disableSWC": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "simulatorPluginLibVersion": {},
  "editorSetting": {}
}
