# Production deployment contract. Replace every REPLACE_WITH_* value before starting the API.
# Only VITE_* variables are safe to expose to frontend builds.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

DATABASE_URL=mysql://REPLACE_WITH_DATABASE_USER:REPLACE_WITH_DATABASE_PASSWORD@database.example.com:3306/REPLACE_WITH_DATABASE_NAME

JWT_USER_SECRET=REPLACE_WITH_UNIQUE_USER_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_ADMIN_SECRET=REPLACE_WITH_UNIQUE_ADMIN_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN_SECONDS=86400

ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

OBJECT_STORAGE_ENDPOINT=https://object-storage.example.com
OBJECT_STORAGE_REGION=REPLACE_WITH_OBJECT_STORAGE_REGION
OBJECT_STORAGE_BUCKET=REPLACE_WITH_OBJECT_STORAGE_BUCKET
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com/REPLACE_WITH_OBJECT_STORAGE_BUCKET
OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_OBJECT_STORAGE_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_OBJECT_STORAGE_SECRET_KEY
OBJECT_STORAGE_FORCE_PATH_STYLE=false
