# Production deployment contract. Replace every REPLACE_WITH_* value through a secret manager.
# This template contains no real credentials. Only variables read by the current API, migration, or build tooling are listed.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

DATABASE_URL=mysql://REPLACE_WITH_DATABASE_USER:REPLACE_WITH_DATABASE_PASSWORD@database.example.com:3306/REPLACE_WITH_DATABASE_NAME

# Emergency 0010/0011 rollback confirmations only. Keep all three at 0 in persistent configuration; never leave any at 1.
BAKE_MALL_MAINTENANCE_MODE=0
BAKE_MALL_IDENTITY_WRITERS_STOPPED=0
BAKE_MALL_PRINTING_WRITERS_STOPPED=0

JWT_USER_SECRET=REPLACE_WITH_UNIQUE_USER_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_ADMIN_SECRET=REPLACE_WITH_UNIQUE_ADMIN_JWT_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_OPERATION_IDEMPOTENCY_SECRET=REPLACE_WITH_UNIQUE_ADMIN_OPERATION_IDEMPOTENCY_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN_SECONDS=86400
SIMULATED_PAYMENT_ENABLED=false
ORDER_QUOTE_TOKEN_SECRET=REPLACE_WITH_UNIQUE_ORDER_QUOTE_SECRET_AT_LEAST_32_CHARACTERS
ORDER_QUOTE_TTL_SECONDS=300
WECHAT_APP_ID=REPLACE_WITH_WECHAT_APP_ID
WECHAT_APP_SECRET=REPLACE_WITH_WECHAT_APP_SECRET
# XPYUN_USER and XPYUN_USER_KEY are required server-only secrets supplied by the deployment secret manager.
XPYUN_USER=REPLACE_WITH_REQUIRED_XPYUN_USER
XPYUN_USER_KEY=REPLACE_WITH_REQUIRED_XPYUN_USER_KEY
# The API enforces this official HTTPS origin in production.
XPYUN_BASE_URL=https://open.xpyun.net
XPYUN_TIMEOUT_MS=10000

ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Map provider-specific COS secret names to these runtime OBJECT_STORAGE_* names in the deployment platform.
OBJECT_STORAGE_ENDPOINT=https://object-storage.example.com
# Optional separate stable HTTPS endpoint used by browser/miniapp presigned uploads.
OBJECT_STORAGE_CLIENT_ENDPOINT=https://object-storage.example.com
OBJECT_STORAGE_REGION=REPLACE_WITH_OBJECT_STORAGE_REGION
OBJECT_STORAGE_BUCKET=REPLACE_WITH_OBJECT_STORAGE_BUCKET
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com/REPLACE_WITH_OBJECT_STORAGE_BUCKET
PRODUCT_MEDIA_ALLOWED_ORIGINS=https://cdn.example.com
OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_OBJECT_STORAGE_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_OBJECT_STORAGE_SECRET_KEY
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# MINIAPP_H5_URL is consumed by the miniapp build and must remain a root-path HTTPS URL.
MINIAPP_H5_URL=https://mall.example.com/
