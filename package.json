{
  "name": "bake-mall",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint '*.mjs' scripts && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "services:up": "node scripts/compose.mjs up -d",
    "services:ps": "node scripts/compose.mjs ps",
    "services:down": "node scripts/compose.mjs down",
    "test:compose-project-name": "node scripts/compose-project-name.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
